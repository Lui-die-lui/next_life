# Supabase project URL (dashboard > Project Settings > API)
SUPABASE_URL=
# Supabase service-role secret key (server-only, never expose to the client)
SUPABASE_SECRET_KEY=
# Postgres connection string used by Prisma (dashboard > Project Settings > Database > Connection string, "Transaction" pooler)
SUPABASE_CONNECTION_KEY=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random secret used to sign/encrypt Better Auth sessions and cookies
BETTER_AUTH_SECRET=
# Base URL Better Auth uses to build its own callback URLs
BETTER_AUTH_URL=

# SMTP (Gmail): smtp.gmail.com, port 587, STARTTLS. SMTP_USER/SMTP_PASSWORD
# are a Gmail address and a Google Account "App Password" for it (not the
# normal account password). MAIL_FROM should be that same Gmail address.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Public base URL of the deployed app, used to build links in notification emails
APP_URL=
# Shared secret required by the scheduled notification endpoint (/api/cron/notify)
CRON_SECRET=